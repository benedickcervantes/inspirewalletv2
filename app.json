{
  "expo": {
    "name": "Inspire Wallet",
    "slug": "investor-wallet",
    "version": "3.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/Startup_DONE.jpg",
    "scheme": "inspirewalletv3",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inspire.inspirewallet",
      "infoPlist": {
        "NSContactsUsageDescription": "This app needs access to your contacts to help you select recipients for transfers.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "This app uses Face ID to provide secure and fast access to your wallet."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Startup_DONE.jpg"
      },
      "package": "com.inspire.inspirewallet",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Startup_DONE.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Startup_DONE.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow InspireWallet to access your contacts to select transfer recipients."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow InspireWallet to use Face ID for secure login."
        }
      ],
      "expo-av"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "amurobrian18",
    "extra": {
      "eas": {
        "projectId": "81d5c41e-b862-48d6-a14d-21246b09c564"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/81d5c41e-b862-48d6-a14d-21246b09c564",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    }
  }
}
