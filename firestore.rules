rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - combined rules for all access patterns
    match /users/{userId} {
      // Allow unauthenticated users to read basic agent information for referral validation
      // This allows agent referral searches during registration
      allow read: if resource.data.agentCode != null 
                  && resource.data.agentCode != "Not an agent" 
                  && resource.data.agentCode != 0;
      
      // Allow unauthenticated users to query by agentNumber for referral validation
      // This is needed for the registration agent search functionality
      // Allow list queries for agent referral searches - both authenticated and unauthenticated
      allow list: if true;
      
      // Allow authenticated users to read/write their own documents
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to read other users' basic info for referrals
      allow read: if request.auth != null 
                  && resource.data.agentCode != null 
                  && resource.data.agentCode != "Not an agent" 
                  && resource.data.agentCode != 0;
      
      // Allow authenticated users to create referral bonus transactions for a referrer
      match /pointsTransactions/{transactionId} {
        // Only the referrer (owner) can read their transactions
        allow read: if request.auth != null && request.auth.uid == userId;

        // Allow any authenticated user to create (add) a referral bonus transaction
        allow create: if request.auth != null;

        // Only the referrer (owner) may update or delete their points transaction
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow subcollections for authenticated users
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Admin users collection - only allow authenticated admin users
    match /adminUsers/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId;
      
      // Allow subcollections for admin users
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == adminId;
      }
    }
    
    // Withdraw requests collection - allow authenticated users to read/write
    match /withdrawRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // Maya applications collection - allow authenticated users to read/write
    match /mayaApplications/{applicationId} {
      allow read, write: if request.auth != null;
    }
    
    // Bank applications collection - allow authenticated users to read/write
    match /bankApplications/{applicationId} {
      allow read, write: if request.auth != null;
    }
    
    // Travel applications collection - allow authenticated users to read/write
    match /travelApplications/{applicationId} {
      allow read, write: if request.auth != null;
    }
    
    // Deposit requests collection - allow authenticated users to read/write
    match /depositRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // KYC requests collection - allow authenticated users to read/write
    match /kycRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // Ticket requests collection - allow authenticated users to read/write
    match /ticketRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // API keys collection - allow authenticated users to read/write
    match /apiKeys/{keyId} {
      allow read, write: if request.auth != null;
    }
    
    // Presence collection - allow authenticated users to read/write
    match /presence/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Global tickets collection - allow authenticated users to read/write
    match /globalTickets/{ticketId} {
      allow read, write: if request.auth != null;
    }
    
    // Collection group queries - allow authenticated users to read
    match /{path=**}/withdrawals/{withdrawalId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/depositRequest/{depositId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/agentTransactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/stockTransactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    
    match /{path=**}/admin_history_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow admins to write notifications
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // App configuration - allow unauthenticated read for maintenance mode check
    match /appConfig/{documentId} {
      allow read: if true; // Allow unauthenticated read for maintenance status
      allow write: if request.auth != null; // Only authenticated users can write
    }
    
    // Fallback rule for any other collections - allow authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
